    """Ligação da tela Eventos SAC com a rotina (eventos/rodar.py).

A rotina trata UMA base por vez. Com várias bases marcadas na tela, ela é
executada uma vez para cada base, em sequência. Se uma base falhar, as
outras continuam; no fim, a tela mostra quais deram erro.
"""

import contextlib
import io
import traceback
from pathlib import Path

from app.worker import Cancelled, Falha

from .eventos import rodar
from .eventos.exportacao import resumo_em_linhas


class _ParaConsole(io.TextIOBase):
    """Manda cada print() da rotina para o console da tela, com cor conforme o conteúdo."""

    def __init__(self, ctx):
        self.ctx, self._buf = ctx, ""

    def write(self, texto):
        self._buf += texto
        while "\n" in self._buf:
            linha, self._buf = self._buf.split("\n", 1)
            linha = linha.rstrip()
            if not linha.strip() or set(linha.strip()) <= {"!", "="}:
                continue  # linhas vazias e "!!!!" / "====" de enfeite do terminal
            if linha.lower().startswith("erro"):
                nivel = "error"
            elif "ATENÇÃO" in linha:
                nivel = "warn"
            else:
                nivel = "step"
            self.ctx.log(linha.strip(), nivel)
        return len(texto)


class _CtxDaBase:
    """Repassa tudo para o ctx da tela, mas converte o progresso de uma base (0-100)
    para a fatia dela no total (ex.: 2 bases -> a 1ª vai de 0 a 50, a 2ª de 50 a 100)."""

    def __init__(self, ctx, indice: int, total: int):
        self._ctx, self._i, self._n = ctx, indice, total

    def progress(self, pct):
        self._ctx.progress((self._i + pct / 100) / self._n * 100)

    def __getattr__(self, nome):  # log, check, section, table, file, cancelled...
        return getattr(self._ctx, nome)


def _mostrar_resultado(ctx, saida: dict) -> None:
    """Resumo organizado em tabelas + arquivos gerados (com link)."""
    secoes: dict[str, list] = {}
    for secao, item, valor in resumo_em_linhas(saida["resultado"], saida["info_execucao"]):
        secoes.setdefault(secao, []).append((item, valor))
    for secao, linhas in secoes.items():
        ctx.table(secao, linhas)

    ctx.log("Arquivos gerados", "info")
    ctx.file(saida["excel_antes"])
    ctx.file(saida["excel_depois"])
    if saida["uploads"]:
        for caminho in saida["uploads"]:
            ctx.file(caminho)
    else:
        ctx.log("TXT de upload não gerado (nenhum lastro no Fluxo Tratado)", "warn")

    if saida["alerta"]:
        for linha in saida["alerta"].splitlines():
            if linha.strip() and set(linha.strip()) - {"!"}:
                ctx.log(linha.strip(), "warn")


def executar(params: dict, ctx) -> str:
    """Chamado pela tela Eventos SAC quando o usuário clica em Processar."""
    bases = params["bases"]
    total = len(bases)
    uploads, falhas, divergencias = 0, [], []

    for i, base in enumerate(bases):
        ctx.check()
        ctx.section(f"Base {base}" + (f"  ({i + 1} de {total})" if total > 1 else ""))
        ctx_base = _CtxDaBase(ctx, i, total)
        try:
            with contextlib.redirect_stdout(_ParaConsole(ctx)):
                saida = rodar.rodar(
                    params["inicio"], params["fim"], base,
                    pasta_saida=Path(params["saida"]) / base,   # Saida/<BASE>/fluxo_...xlsx
                    pasta_upload=params["upload"],             # Upload/<BASE>/fluxo_<BASE>_...txt
                    arquivo_filtros=params["filtros"],
                    ctx=ctx_base,
                )
        except Cancelled:
            raise
        except PermissionError as exc:
            falhas.append(base)
            ctx.log(f"Não foi possível gravar {exc.filename}. "
                    "Se o arquivo estiver aberto no Excel, feche e rode de novo.", "error")
            continue
        except Exception as exc:  # noqa: BLE001 - uma base com erro não para as outras
            falhas.append(base)
            ctx.log(f"Base {base} falhou: {exc}", "error")
            if not isinstance(exc, (RuntimeError, ValueError, FileNotFoundError)):
                # erro inesperado: mostra onde aconteceu (em cinza), para facilitar a correção
                ctx.log(traceback.format_exc().rstrip(), "trace")
            continue

        _mostrar_resultado(ctx, saida)
        uploads += len(saida["uploads"])
        if saida["alerta"]:
            divergencias.append(base)
        ctx.log(f"Base {base} concluída", "ok")

    # Fechamento geral ---------------------------------------------------------
    if total > 1:
        ctx.section("Resumo geral")
        ctx.table("Bases", [(b, "ERRO" if b in falhas else ("com divergência" if b in divergencias else "OK"))
                            for b in bases])
    if falhas:
        raise Falha(f"{len(falhas)} de {total} base(s) com erro: {', '.join(falhas)}."
                    + (" As demais foram geradas normalmente." if len(falhas) < total else ""))
    if divergencias:
        ctx.log(f"Divergência na soma das amortizações (I) em: {', '.join(divergencias)}. "
                "Veja a aba 'Divergência de Amortização' no Excel DEPOIS.", "warn")
    return (f"Eventos SAC concluído: {total} base(s), "
            f"{uploads} arquivo(s) de upload gerado(s).")






