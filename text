def validar_base(base: str) -> str:
    """Normaliza a base (ex.: ' lz ' -> 'LZ'). Só aceita letras e números (protege a query)."""
    limpa = str(base).strip().upper()
    if not re.fullmatch(r"[A-Z0-9_]+", limpa):
        raise ValueError(f"Base inválida: {base!r}")
    return limpa


