    # Montagem do texto -------------------------------------------------------
    # Níveis aceitos em log(): info, step, ok, warn, error, title, trace e os especiais
    # section (título de seção), file (caminho de arquivo, vira link) e table (JSON).
    _MARCAS = {"ok": "✓", "warn": "!", "error": "✕", "step": "›", "title": "▸"}

    def _cores(self) -> dict:
        t = theme.current()
        return {
            "info": t["con_text"], "step": t["con_info"], "ok": t["con_ok"], "warn": t["con_warn"],
            "error": t["con_error"], "title": "#FFFFFF", "trace": t["con_muted"],
            "muted": t["con_muted"], "section": t["con_section"], "key": t["con_key"],
            "value": t["con_value"], "link": t["con_link"],
        }

    def _recuo(self) -> int:
        """Largura de "00:00:00  ✓ ": as linhas quebradas alinham depois do horário."""
        return QtGui.QFontMetrics(self.text.font()).horizontalAdvance("00:00:00  ✓ ") + 2

    def _bloco(self, left: int = 0, indent: int = 0, top: int = 0) -> QtGui.QTextCursor:
        """Abre uma linha nova no fim do documento com o recuo pedido."""
        doc = self.text.document()
        cur = QtGui.QTextCursor(doc)
        cur.movePosition(QtGui.QTextCursor.MoveOperation.End)
        fmt = QtGui.QTextBlockFormat()
        fmt.setLeftMargin(left)
        fmt.setTextIndent(indent)
        fmt.setTopMargin(top)
        fmt.setLineHeight(135, QtGui.QTextBlockFormat.LineHeightTypes.ProportionalHeight.value)
        if doc.isEmpty():
            cur.setBlockFormat(fmt)
        else:
            cur.insertBlock(fmt)
        return cur

    @staticmethod
    def _escrever(cur, texto: str, cor: str, negrito: bool = False, href: str = ""):
        cf = QtGui.QTextCharFormat()
        cf.setForeground(QtGui.QColor(cor))
        if negrito:
            cf.setFontWeight(QtGui.QFont.Weight.DemiBold)
        if href:
            cf.setAnchor(True)
            cf.setAnchorHref(href)
            cf.setFontUnderline(True)
        cur.insertText(texto, cf)

    def _rolar(self):
        sb = self.text.verticalScrollBar()
        sb.setValue(sb.maximum())

    def log(self, message: str, level: str = "info"):
        especiais = {"section": self._secao, "file": self._arquivo, "table": self._tabela}
        if level in especiais:
            especiais[level](message)
            self._rolar()
            return
        c = self._cores()
        cor = c.get(level, c["info"])
        recuo = self._recuo()
        for i, linha in enumerate(str(message).splitlines() or [""]):
            cur = self._bloco(left=recuo, indent=-recuo)
            carimbo = datetime.now().strftime("%H:%M:%S") if i == 0 else " " * 8
            self._escrever(cur, f"{carimbo}  ", c["muted"])
            marca = self._MARCAS.get(level, " ") if i == 0 else " "
            self._escrever(cur, f"{marca} ", cor)
            self._escrever(cur, linha, cor, negrito=(level == "title"))
        self._rolar()

    def _secao(self, titulo: str):
        """Título de seção (ex.: "Base LZ (1 de 2)") com espaço antes."""
        c = self._cores()
        cur = self._bloco(top=12)
        self._escrever(cur, "━━ ", c["section"])
        self._escrever(cur, titulo, c["section"], negrito=True)

    def _arquivo(self, caminho: str):
        """Arquivo gerado: nome clicável (abre a pasta) + pasta em cinza."""
        c = self._cores()
        p = Path(caminho)
        cur = self._bloco(left=self._recuo() + 4)
        self._escrever(cur, "↳ ", c["muted"])
        self._escrever(cur, p.name, c["link"], href=QtCore.QUrl.fromLocalFile(str(p)).toString())
        self._escrever(cur, f"   {p.parent.parent.name}\\{p.parent.name}", c["muted"])

    def _tabela(self, dados: str):
        """Tabela chave/valor. `dados` = JSON {"titulo": str, "linhas": [[chave, valor], ...]}."""
        import json

        c = self._cores()
        info = json.loads(dados)
        recuo = self._recuo()
        cur = self._bloco(left=recuo, top=6)
        self._escrever(cur, info.get("titulo", ""), c["key"], negrito=True)

        linhas = info.get("linhas", [])
        if not linhas:
            return
        tf = QtGui.QTextTableFormat()
        tf.setBorder(0)
        tf.setBorderStyle(QtGui.QTextFrameFormat.BorderStyle.BorderStyle_None)
        tf.setCellPadding(1)
        tf.setCellSpacing(0)
        tf.setLeftMargin(recuo + 4)
        tf.setColumnWidthConstraints([
            QtGui.QTextLength(QtGui.QTextLength.Type.PercentageLength, 64),
            QtGui.QTextLength(QtGui.QTextLength.Type.PercentageLength, 36),
        ])
        cur.movePosition(QtGui.QTextCursor.MoveOperation.End)
        tabela = cur.insertTable(len(linhas), 2, tf)
        for i, (chave, valor) in enumerate(linhas):
            texto = str(valor)
            cor_valor = {"ERRO": c["error"], "OK": c["ok"],
                         "COM DIVERGÊNCIA": c["warn"]}.get(texto.strip().upper(), c["value"])
            self._escrever(tabela.cellAt(i, 0).firstCursorPosition(), str(chave), c["key"])
            self._escrever(tabela.cellAt(i, 1).firstCursorPosition(), texto, cor_valor)




































