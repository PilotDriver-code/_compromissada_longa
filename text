"""
Rotina principal: monta e executa a query no Athena, trata o resultado e
gera os Excel ANTES e DEPOIS e os TXT de upload.

Na Central, quem chama esta rotina é a tela Eventos SAC (via tasks/eventos_sac/eventos_sac.py),
passando as datas, as bases e as pastas. A janela de posição
(D-7 a D-1 úteis ANBIMA da data inicial) é calculada automaticamente.

Para rodar sem a tela (a partir da pasta da Central, onde está o main.py):
    python -m tasks.eventos_sac.eventos.rodar
"""

import json
import re
from pathlib import Path

import pandas as pd
from bizdays import Calendar

from core import configuracoes as cfg
from ..aws.query_eventos import QUERY_EVENTOS
from .exportacao import (formatar_alerta_divergencias, formatar_resumo_terminal,
                         gerar_arquivos_upload, gerar_excels)

# ---------------------------------------------------------------------------
# Configuração
# ---------------------------------------------------------------------------
# Usados só quando o arquivo é rodado direto (sem a tela)
DATA_INICIAL = "2026-11-10"
DATA_FINAL = "2026-11-10"
BASES = ["LZ"]

DSN_ATHENA = "AWS Athena ODBC"
DIAS_UTEIS_POSICAO = 7   # janela de posição: D-7 até D-1

# True  = eventos do intervalo em fim de semana/feriado vão para o próximo dia útil
#         (data cadastrada fica na coluna data_evento_original)
# False = mantém as datas cadastradas
LEVAR_PARA_DIA_UTIL = True


# ---------------------------------------------------------------------------
# Configuração de filtros
# ---------------------------------------------------------------------------
def carregar_tipos_ativo(caminho: Path | None = None) -> list[str]:
    """Lê a lista de tipos de ativo que entram na análise (setup/Config/filtros.json)."""
    caminho = Path(caminho or cfg.arquivo_filtros_eventos())
    if not caminho.exists():
        raise FileNotFoundError(f"Arquivo de configuração não encontrado: {caminho}")
    config = json.loads(caminho.read_text(encoding="utf-8"))
    tipos = [str(t).strip() for t in config.get("tipos_ativo", []) if str(t).strip()]
    if not tipos:
        raise ValueError(f"Nenhum tipo de ativo configurado em 'tipos_ativo' ({caminho}).")
    return tipos


# ---------------------------------------------------------------------------
# Datas e bases da query
# ---------------------------------------------------------------------------
def calcular_janela_posicao(data_inicial) -> tuple[pd.Timestamp, pd.Timestamp]:
    """
    D-7 a D-1 dias úteis ANBIMA da data inicial.
    Se a data inicial não for dia útil (ex.: sábado), o D-1 é o último dia útil antes dela.
    """
    cal = Calendar.load(name="ANBIMA")
    dia_anterior = (pd.Timestamp(data_inicial).normalize() - pd.Timedelta(days=1)).strftime("%Y-%m-%d")
    d_menos_1 = pd.Timestamp(cal.preceding(dia_anterior))
    d_menos_7 = pd.Timestamp(cal.offset(d_menos_1.strftime("%Y-%m-%d"), -(DIAS_UTEIS_POSICAO - 1)))
    return d_menos_7, d_menos_1


def bases_para_sql(bases: list[str]) -> str:
    """['LZ', 'XZ'] -> "'LZ', 'XZ'". Só aceita letras e números (protege a query)."""
    limpas = [str(b).strip().upper() for b in bases if str(b).strip()]
    if not limpas:
        raise ValueError("Nenhuma base informada.")
    invalidas = [b for b in limpas if not re.fullmatch(r"[A-Z0-9_]+", b)]
    if invalidas:
        raise ValueError(f"Base(s) inválida(s): {', '.join(invalidas)}")
    return ", ".join(f"'{b}'" for b in limpas)


def montar_query(data_inicial, data_final, bases: list[str]) -> str:
    """Preenche a query com as bases, as datas do evento e a janela de posição."""
    ini = pd.Timestamp(data_inicial).normalize()
    fim = pd.Timestamp(data_final).normalize()
    if ini > fim:
        raise ValueError(f"Data inicial ({ini:%d/%m/%Y}) maior que a data final ({fim:%d/%m/%Y}).")

    posicao_de, posicao_ate = calcular_janela_posicao(ini)
    print(f"Eventos: {ini:%d/%m/%Y} a {fim:%d/%m/%Y} | "
          f"Posição: {posicao_de:%d/%m/%Y} a {posicao_ate:%d/%m/%Y}")

    um_dia = pd.Timedelta(days=1)
    return QUERY_EVENTOS.format(
        bases=bases_para_sql(bases),
        evento_de=f"{ini:%Y-%m-%d}",
        evento_ate_exclusivo=f"{fim + um_dia:%Y-%m-%d}",
        posicao_de=f"{posicao_de:%Y-%m-%d}",
        posicao_ate_exclusivo=f"{posicao_ate + um_dia:%Y-%m-%d}",
    )


# ---------------------------------------------------------------------------
# Athena
# ---------------------------------------------------------------------------
def executar_query_athena(query: str) -> pd.DataFrame | None:
    """Executa a query via ODBC (DSN configurado na máquina) e devolve um DataFrame."""
    import pyodbc  # aqui dentro: a Central abre mesmo sem o driver instalado

    try:
        connection = pyodbc.connect(f"DSN={DSN_ATHENA}", timeout=30)
        cursor = connection.cursor()
        cursor.execute(query)
        columns = [column[0] for column in cursor.description]
        results = cursor.fetchall()
        cursor.close()
        connection.close()
        return pd.DataFrame.from_records(results, columns=columns)
    except pyodbc.Error as e:
        print("Erro ao conectar ou executar a query:", e)
        return None


def obter_dados_athena(data_inicial, data_final, bases: list[str]) -> pd.DataFrame:
    """Monta a query com as datas e bases, executa e devolve o DataFrame."""
    df = executar_query_athena(montar_query(data_inicial, data_final, bases))
    if df is None:
        raise RuntimeError("A query no Athena falhou (ver mensagem de erro acima).")
    return df


# ---------------------------------------------------------------------------
# Rotina
# ---------------------------------------------------------------------------
def _avancar(ctx, pct: int) -> None:
    """Atualiza a barra da tela e respeita o botão Cancelar (sem tela, não faz nada)."""
    if ctx is not None:
        ctx.check()
        ctx.progress(pct)


def rodar(data_inicial, data_final, bases: list[str],
          pasta_saida: Path | None = None, pasta_upload: Path | None = None,
          arquivo_filtros: Path | None = None, ctx=None) -> dict:
    """
    Executa a rotina completa.
    Devolve {"resultado", "excel_antes", "excel_depois", "uploads", "alerta"}.
    """
    pasta_saida = Path(pasta_saida or cfg.pasta("eventos_saida"))
    pasta_upload = Path(pasta_upload or cfg.pasta("eventos_upload"))

    _avancar(ctx, 5)
    tipos_ativo = carregar_tipos_ativo(arquivo_filtros)
    ini, fim = pd.Timestamp(data_inicial).normalize(), pd.Timestamp(data_final).normalize()
    posicao_de, posicao_ate = calcular_janela_posicao(ini)
    info_execucao = {
        "Bases": ", ".join(bases),
        "Fluxo - data inicial": f"{ini:%d/%m/%Y}",
        "Fluxo - data final": f"{fim:%d/%m/%Y}",
        "Posição - data inicial": f"{posicao_de:%d/%m/%Y}",
        "Posição - data final": f"{posicao_ate:%d/%m/%Y}",
        "Tipos de ativo considerados": ", ".join(tipos_ativo),
    }

    _avancar(ctx, 10)
    print("Executando a query no Athena...")
    df = obter_dados_athena(data_inicial, data_final, bases)
    print(f"Query retornou {len(df)} linha(s).")

    _avancar(ctx, 60)
    print("Tratando o fluxo e gerando os Excel...")
    caminho_antes, caminho_depois, resultado = gerar_excels(
        df, data_inicial, data_final, pasta_saida,
        levar_para_dia_util=LEVAR_PARA_DIA_UTIL, tipos_ativo=tipos_ativo, info_execucao=info_execucao,
    )

    _avancar(ctx, 85)
    arquivos_upload = gerar_arquivos_upload(resultado, data_inicial, data_final, pasta_upload)

    _avancar(ctx, 95)
    print()
    print(formatar_resumo_terminal(resultado, info_execucao))
    print(f"\nExcel ANTES : {caminho_antes}")
    print(f"Excel DEPOIS: {caminho_depois}")
    if arquivos_upload:
        for caminho in arquivos_upload:
            print(f"TXT upload  : {caminho}")
    else:
        print("TXT upload  : não gerado (nenhum lastro no Fluxo Tratado)")

    alerta = formatar_alerta_divergencias(resultado)
    if alerta:
        print(alerta)
    _avancar(ctx, 100)
    return {
        "resultado": resultado,
        "excel_antes": caminho_antes,
        "excel_depois": caminho_depois,
        "uploads": arquivos_upload,
        "alerta": alerta,
    }


if __name__ == "__main__":
    rodar(DATA_INICIAL, DATA_FINAL, BASES)
