"""Ligação da tela Eventos SAC com a rotina (eventos/rodar.py)."""

import contextlib
import io
from pathlib import Path

from .eventos import rodar


class _ParaConsole(io.TextIOBase):
    """Manda cada print() da rotina para o console da tela, com cor conforme o conteúdo."""

    def __init__(self, ctx):
        self.ctx, self._buf = ctx, ""

    def write(self, texto):
        self._buf += texto
        while "\n" in self._buf:
            linha, self._buf = self._buf.split("\n", 1)
            if not linha.strip():
                continue
            if linha.lower().startswith("erro"):
                nivel = "error"
            elif "ATENÇÃO" in linha or linha.startswith("!!!"):
                nivel = "warn"
            else:
                nivel = "info"
            self.ctx.log(linha, nivel)
        return len(texto)


def executar(params: dict, ctx) -> str:
    """Chamado pela tela Eventos SAC quando o usuário clica em Processar."""
    bases = params["bases"]
    # Uma subpasta por combinação de bases: rodar LZ e depois XZ na mesma data não sobrescreve o Excel
    pasta_saida = Path(params["saida"]) / "_".join(bases)

    with contextlib.redirect_stdout(_ParaConsole(ctx)):
        try:
            saida = rodar.rodar(
                params["inicio"], params["fim"], bases,
                pasta_saida=pasta_saida,
                pasta_upload=params["upload"],
                arquivo_filtros=params["filtros"],
                ctx=ctx,
            )
        except PermissionError as exc:
            raise RuntimeError(
                f"Não foi possível gravar {exc.filename}. "
                "Se o arquivo estiver aberto no Excel, feche e rode de novo."
            ) from exc

    if saida["alerta"]:
        ctx.log("Há divergência na soma das amortizações (I): veja o Excel DEPOIS.", "warn")

    uploads = saida["uploads"]
    if uploads:
        return f"Eventos SAC concluído: {len(uploads)} arquivo(s) de upload gerado(s)."
    return "Eventos SAC concluído: nenhum TXT de upload (nenhum lastro no Fluxo Tratado)."
