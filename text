3c. Apague a função _tabela inteira e cole no lugar estas três funções:

python
    def _nova_tabela(self, linhas: int, titulo: str, colunas=(62, 38)):
        """Tabela com borda e cabeçalho (1ª linha, mesclada, com o título).
        `colunas` = largura de cada coluna em % (chave, valor)."""
        c = self._cores()
        recuo = self._recuo()
        cur = self._bloco(left=recuo)
        tf = QtGui.QTextTableFormat()
        tf.setBorder(1)
        tf.setBorderStyle(QtGui.QTextFrameFormat.BorderStyle.BorderStyle_Solid)
        tf.setBorderBrush(QtGui.QBrush(QtGui.QColor(c["border"])))
        tf.setBorderCollapse(True)          # uma linha só entre as células
        tf.setCellPadding(5)
        tf.setCellSpacing(0)
        tf.setLeftMargin(recuo)
        tf.setTopMargin(10)                 # respiro entre uma tabela e a anterior
        tf.setWidth(QtGui.QTextLength(QtGui.QTextLength.Type.PercentageLength, 100))
        tf.setColumnWidthConstraints([
            QtGui.QTextLength(QtGui.QTextLength.Type.PercentageLength, colunas[0]),
            QtGui.QTextLength(QtGui.QTextLength.Type.PercentageLength, colunas[1]),
        ])
        tabela = cur.insertTable(linhas + 1, 2, tf)
        tabela.mergeCells(0, 0, 1, 2)
        cab = tabela.cellAt(0, 0)
        fmt = cab.format()
        fmt.setBackground(QtGui.QColor(c["header_bg"]))
        cab.setFormat(fmt)
        self._escrever(cab.firstCursorPosition(), titulo, c["title"], negrito=True)
        return tabela

    def _tabela(self, dados: str):
        """Tabela chave/valor. `dados` = JSON {"titulo": str, "linhas": [[chave, valor], ...]}."""
        import json

        c = self._cores()
        info = json.loads(dados)
        linhas = info.get("linhas", [])
        tabela = self._nova_tabela(len(linhas), info.get("titulo", ""))
        for i, (chave, valor) in enumerate(linhas, start=1):
            texto = str(valor)
            cor_valor = {"ERRO": c["error"], "OK": c["ok"],
                         "COM DIVERGÊNCIA": c["warn"]}.get(texto.strip().upper(), c["value"])
            self._escrever(tabela.cellAt(i, 0).firstCursorPosition(), str(chave), c["key"])
            self._escrever(tabela.cellAt(i, 1).firstCursorPosition(), texto, cor_valor)

    def _arquivos(self, dados: str):
        """Quadro dos arquivos gerados. `dados` = JSON {"titulo": str, "caminhos": [...]}.
        Nome clicável (abre a pasta) à esquerda e a pasta à direita."""
        import json

        c = self._cores()
        info = json.loads(dados)
        caminhos = info.get("caminhos", [])
        tabela = self._nova_tabela(len(caminhos), info.get("titulo", "Arquivos gerados"), colunas=(78, 22))
        for i, caminho in enumerate(caminhos, start=1):
            p = Path(caminho)
            href = QtCore.QUrl.fromLocalFile(str(p)).toString()
            self._escrever(tabela.cellAt(i, 0).firstCursorPosition(), p.name, c["link"], href=href)
            self._escrever(tabela.cellAt(i, 1).firstCursorPosition(),
                           f"{p.parent.parent.name}\\{p.parent.name}", c["muted"])
        # linha em branco depois do quadro, para separar do que vem a seguir
        self._bloco(top=4)
